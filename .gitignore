# OS
.DS_Store

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/
*.egg-info/

# Node / Next.js
node_modules/
.next/
out/
dist/
*.tsbuildinfo

# Environment — never commit real secrets; .env.example is tracked
.env
.env.*
!.env.example

# Agent tooling. `.agents/` and skills-lock.json are tracked: they pin which
# skills this repo uses, by content hash, so a checkout gets the same ones.
# `.claude/` is local machine state -- granted permissions and symlinks into
# .agents/ that the CLI rebuilds itself.
.claude/

# Next.js frontend
frontend/.next/
frontend/node_modules/
frontend/.env.local
frontend/next-env.d.ts
