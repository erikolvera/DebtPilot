# Comma-separated CORS origins for the API. Every Vercel preview deployment
# gets its own origin, so this must not be hardcoded in the app.
ALLOWED_ORIGINS=http://localhost:3000

# Supabase project URL. Used to fetch JWKS and to check the token's `iss`.
SUPABASE_URL=https://your-project.supabase.co

# Postgres connection. Contains a password: never commit a real value.
#
# Connect as a role that row-level security APPLIES to. The `postgres` role
# has rolbypassrls=true and would silently ignore every policy -- and every
# test would still pass. `app_user` is created by the migration with
# nosuperuser and nobypassrls for exactly this reason.
#
# `supabase start` prints the local DB URL; swap the role and password in.
# The migration creates app_user with NOLOGIN and no password -- a password
# there would be published to the hosted project by `supabase db push`, for a
# role that can impersonate any user. Locally, scripts/bootstrap_local_db.sh
# grants the login; in production, set it in the Supabase dashboard.
DATABASE_URL=postgresql+psycopg://app_user:CHANGE_ME@127.0.0.1:54322/postgres

# Google Gemini API key for the guidance layer.
#
# Leave it unset and /v1/payoff-plans/explain serves a hand-written template
# instead: correct, deterministic, and the intended local-development path.
# The template is also the production fallback whenever Gemini is unavailable,
# so it is real code rather than a stub.
#
# Set a monthly spend limit in the Gemini console. The application's per-caller
# rate limit is a speed bump; it cannot protect against a bug in the
# application.
GEMINI_API_KEY=

# Whether X-Forwarded-For may be trusted for rate-limit bucketing.
#
# Leave unset locally and anywhere the API is exposed directly: the header is
# caller-controlled, so trusting it hands an abuser an unlimited supply of
# buckets. Set it to 1 ONLY behind a proxy that overwrites the header --
# Render does -- because otherwise every user shares the proxy's address and
# the limit collapses to one bucket for the whole world.
TRUST_PROXY_HEADERS=
